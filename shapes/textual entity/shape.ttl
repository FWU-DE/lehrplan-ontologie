@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:    <http://www.example.org/#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

# a textual entity always is about something

@prefix textual_entity: <http://purl.obolibrary.org/obo/IAO_0000300> .
@prefix is_about: <http://purl.obolibrary.org/obo/IAO_0000136> .

ex:TextualEntityShape
    a sh:NodeShape ;
    sh:targetClass textual_entity:  ; 
    sh:property [   
        sh:path  is_about:  ; 
        sh:minCount 1 ;
    ] ;
    .