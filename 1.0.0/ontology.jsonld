  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@language" : "de",
    "@value" : "Ggf. könnte auf Wahlfach und Pflichfach geschlossen werden. Dies ist aktuell nicht implementiert."
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000547",
