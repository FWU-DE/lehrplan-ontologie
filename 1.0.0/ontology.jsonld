  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000478",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Funktionsspezifikation"
  }, {
    "@language" : "en",
    "@value" : "function specification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000030"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000479",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000493"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Ein Element, das diese Funktion inne hat, beschreibt Kompetenzen, die SuS haben können oder eine Ausführung in der die Kompetenz angewandt wird."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Kompetenzbeschreibungsfunktion"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "de",
    "@value" : "Ein Lehrplanelement das die Funktion inne hat das beschreibt z.B. \"Die SuS sollen Kompexen Zahlen addieren können\" oder \"über Konflikte sprechen\". Üblicherweise beginnt die Beschreibung mit \"Die SuS sollen .... \". Die Beschreibungen enthalten üblicherweise Operatoren."
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000480",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000493"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Ein Element, das diese Funktion inne hat, beschreibt Inhalte, die im Unterricht vermittelt werden. Es beschreibt konkrete Themen oder Handlungsanweisungen zur Gestaltung des Unterrichts oder Mittel zum Erlangen von Kompetenzen."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Lerninhaltsbeschreibungsfunktion"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000481",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000493"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Ein Element, das diese Funktion inne hat, beschreibt Materialien, die im Unterricht verwendet werden können."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Materialbeschreibungsfunktion"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000482",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Elemente, die diese Funktion inne haben, strukturieren die Lehrpläne."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Strukturierungsfunktion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000478"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "de",
    "@value" : "Überschriften, Kapitel, Themenfelder, Kompetenzbereiche"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000483",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has function specification"
  }, {
    "@language" : "de",
    "@value" : "hat Funktion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000478"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000024"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000495"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "de",
    "@value" : "hat Funktionsspezifikation"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000493",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Elemente, die diese Funktion inne haben, beschreiben Teile des Lehrplans."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Beschreibungsfunktion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000478"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000495",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is function specification of"
  }, {
    "@language" : "de",
    "@value" : "ist Funktion von"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000136"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000497",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000482"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Ein Lehrplanelement, das diese Funtion inne hat, beschreibt einen Kompetenzbereich. Einem Kompetenzberich können Teilkomptenzbereiche untergeordnet werden."
  }, {
    "@language" : "de",
    "@value" : "Ein Lehrplanelement, das diese Funtion inne hat, beschreibt einen Teilkompetenzbereich. Teilkompetenzbereiche sind üblicherweise einem Kompetenzbereich oder anderen Teilkompetenzbereich untergeordnet."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Bereichsfunktion"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "de",
    "@value" : "Ein Lehrplanelement, das diese Funtion inne hat, beschreibt einen Thema. Einem Thema kann einem Themenfeld oder anderen Themen untergeordnet werden."
  }, {
    "@language" : "de",
    "@value" : "Ein Lehrplanelement, das diese Funtion inne hat, beschreibt einen Themenfeld. Einem Themenfeld können Themen untergeordnet werden."
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000499",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Bezugsfunktion ist eine Funktionsspezifikation und kennzeichnet, welche inhaltliche Rolle ein länderspezifisches Curriculares Element im Lehrplan spielt – genauer: worauf es sich inhaltlich bezieht.\nDie Ontologie definiert drei konkrete Bezugsfunktionen als Individuen. Die Begrifflichkeiten stammen aus den Bildungsstandards der KMK. Sie gelten besonders für die Fächer Deutsch und Mathematik."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Bezugsfunktionen"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000478"
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "Die Bezugsfunktion ist kein Freitext, sondern wird als OWL-Restriktion direkt in die Klassendefinition des länderspezifischen CE eingebaut: Jede CE-Klasse wie Kompetenzbereich (HH), Lernbereich (BY) oder Inhaltsfeld (NW) trägt in ihrer rdfs:subClassOf-Axiomatik eine owl:hasValue-Restriktion auf hat Funktion (LP_0000483), die auf das entsprechende Bezugsfunktions-Individuum zeigt. Das bedeutet: Sobald ein Lehrplanelement als Kompetenzbereich (HH) typisiert ist, weiß das System automatisch – ohne zusätzliche Aussagen in den Daten –, dass dieses Element die Bereichsfunktion trägt und damit einem CE-Bereich entspricht."
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000500",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000499"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Prozessbezugsfunktion"
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "beschreibt prozessorientierte Kompetenzen – also wie gelernt oder gehandelt wird"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000501",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000499"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Inhaltsbezugsfunktion"
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "beschreibt inhaltsorientierte Kompetenzen – also was gelernt wird"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000506",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000530"
  }, {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0002069"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Grundkursfach (BB)"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000507",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000531"
  }, {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0002069"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Leistungskursfach (BB)"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000508",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Ein Data Item, dass für eine Unterrichtseinheit einen Wert für Zeitdauer und die dazugehörige Einheit beschreibt."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Zeitspezifikation"
  }, {
    "@language" : "en",
    "@value" : "temporal specification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000027"
  }, {
    "@id" : "_:genid566"
  }, {
    "@id" : "_:genid571"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@value" : "Soll z.B. ausgedrückt werden, dass der Unterricht 6 Unterrichtsstunden enhält kann folgendes Muster verwendet werden:\n\n:unterricht_1 'mem:described by' :zs_1 .\n:zs_1 a mem:Zeitpezifikation .\n:zs_1 'mem:hat Wert' \"6\"^^xsd:decimal .\n:zs_1 'mem:hat Einheit' 'mem:Unterrichtsstunde' .\n\nSoll ausgedrückt werden, dass der Unterricht 6 Zeitstunden enhält kann folgendes Muster verwendet werden:\n\n:unterricht_1 'mem:described by' :zs_1 .\n:zs_1 a mem:Zeitpezifikation .\n:zs_1 'mem:hat Wert' \"6\"^^xsd:decimal .\n:zs_1 'mem:hat Einheit' 'qudt:HR' ."
  } ]
}, {
