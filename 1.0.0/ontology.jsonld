  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000545",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Schulfachbezug, der ausdrückt, dass ein Schulfach als Wahlpflicht gemeint ist."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
