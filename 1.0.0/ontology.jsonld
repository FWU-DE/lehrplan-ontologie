}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000530",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A \"Grundkursniveau\" is a \"Fachniveau Sek II\" within the Gymnasium track of upper secondary education (\"Sekundarstufe II\") that conveys content and competencies at a basic level of requirements.\nIt describes the depth and level of demand with which learning content and competencies are addressed within a subject."
  }, {
    "@language" : "de",
    "@value" : "Ein \"Grundkursniveau\" ist ein “Fachniveau Sek II” im gymnasialen Bildungsgang der Sekundarstufe II, das Inhalte und Kompetenzen auf einem grundlegenden Anforderungsniveau vermittelt.\nEs beschreibt in welcher Tiefe und mit welchem Anspruch die Lerninhalte und Kompetenzen innerhalb eines Fachs behandelt werden."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Grundkursniveau"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000265"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000531",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A \"Leistungskursniveau\" is a \"Fachniveau Sek II\" within the Gymnasium track of upper secondary education (\"Sekundarstufe II\") that conveys content and competencies at an advanced level of requirements.\nIt describes the depth and level of demand with which learning content and competencies are addressed within a subject."
  }, {
    "@language" : "de",
    "@value" : "Ein \"Leistungskursniveau\" ist ein “Fachniveau Sek II” im gymnasialen Bildungsgang der Sekundarstufe II, das Inhalte und Kompetenzen auf einem vertieften Anforderungsniveau vermittelt.\nEs beschreibt in welcher Tiefe und mit welchem Anspruch die Lerninhalte und Kompetenzen innerhalb eines Fachs behandelt werden."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Leistungskursniveau"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000265"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000532",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000478"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Optional"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000533",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000478"
  } ],
