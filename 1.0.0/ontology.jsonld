  }, {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_2000013"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000053",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
