    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000475"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "concretizes type of school"
  }, {
    "@language" : "de",
    "@value" : "konkretisiert Schulart"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000111"
  } ],
