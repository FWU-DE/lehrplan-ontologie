  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0002163",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Beispiel Verknüpfung von Inhalt und Kompetenzbereich (MV)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid1070"
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "Ist einem Themenbereich (o.ä.) untergeordnet (bzw. einem verbindlichen Inhalt oder einem Hinweis zugeordnet) und zusätzlich einem Kompetenzbereich zugeordnet."
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0002164",
