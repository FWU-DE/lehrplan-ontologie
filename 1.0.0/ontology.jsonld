}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0030065",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A \"CE-Verweis\" is a \"Curriculares Element\" that establishes a connection from one “Curriculares Element” to another element within the same curriculum, a different curriculum, or external resources. The \"CE-Verweis\" is not the linked object itself but rather a reference to it."
  }, {
    "@language" : "de",
    "@value" : "Ein “CE-Verweis” ist ein “Curriculares Element”, das einen Bezug von einem Curricularen Element zu einem anderen Element desselben Lehrplans, eines anderen Lehrplans oder externen Ressourcen herstellt. Dabei ist der “CE-Verweis” nicht selbst das verlinkte Objekt, sondern stellt eine Referenz darauf dar."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "CE-Verweis"
  }, {
    "@language" : "en",
    "@value" : "reference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000261"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid1600"
  } ]
