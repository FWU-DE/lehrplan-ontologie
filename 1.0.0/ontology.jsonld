    "@id" : "_:genid93"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000054",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Ohne-Berlin-Brandenburg"
  } ],
