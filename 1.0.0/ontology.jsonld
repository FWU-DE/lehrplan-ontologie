  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000349"
  }, {
    "@id" : "_:genid445"
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "kommt in Mathematik Sek II vor.\ns. außerdem Moderne Fremdsprache - Englisch Sek I."
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000332",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A “CE-Lerninhalt” is a “curricular element” that describes a learning content in the form of specific topics. The “CE-Lerninhalt” provides the content basis for the preparation of school lessons.\nCompetencies can be acquired on the basis of the “CE-Lerninhalt”.\nA “CE-Lerninhalt” can contain another “CE-Lerninhalt”, but no other element (such as e.g. “CE-Bereich” or “CE-Kompetenzspezifikation”)."
  }, {
    "@language" : "de",
    "@value" : "Ein “CE-Lerninhalt” ist ein “Curriculares Element\", das einen Lerninhalt in Form konkreter Themen beschreibt. Der „CE-Lerninhalt“ liefert die inhaltliche Basis für die Gestaltung des Unterrichts.\nAnhand des \"CE-Lerninhalts\" können Kompetenzen erworben werden.\nEin CE-Lerninhalt kann einen anderen CE-Lerninhalt enthalten, aber kein anderes Element (wie z.B. CE-Bereich oder CE-Kompetenzspezifikation). \n\n\nBeispiel:\n\nCE-Kompetenzspezifikation: Die Schülerinnen und Schüler setzen sich auf der Grundlage ihrer Kenntnisse bewusst mit der englischen Sprache und den mit ihr verbundenen Kulturräumen auseinander.\nCE-Lerninhalt: Kanada: Einblicke in Geographie und Gesellschaft; Inuit/First People"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "CE-Lerninhalt"
  }, {
    "@language" : "en",
    "@value" : "learning content"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000261"
  }, {
    "@id" : "_:genid459"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid449"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000336",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Fachbezogene Kompetenzspezifikation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000263"
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "Bezieht sich auf ein bestimmtes Fach"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000337",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Fachübergreifende Kompetenzspezifikation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000263"
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@language" : "de",
    "@value" : "Bezüglich mehrere Fächer bzw. eines Fachverbund"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000342",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Lehrplan Element bezogen auf den Lehrplan von Rheinland-Pfalz"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Element (RP)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000261"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid464"
  } ]
