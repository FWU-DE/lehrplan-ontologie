  }, {
    "@id" : "_:genid1326"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid1322"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0030005",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Ergänzung zu einem Basiskonzept (NW)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid1327"
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "Der Begriff kommt so nicht im Lehrplan vor. Kommt nur in den Naturwissenschaften vor. Ist eine Ergänzung zu den Bezügen zu den Basiskonzepten und ergänzt gleichzeitig die davor genannten inhaltlichen Schwerpunkte."
  } ]
