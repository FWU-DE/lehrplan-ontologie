    "@language" : "en",
    "@value" : "All definitions, placement in the asserted IS_A hierarchy and required minimal metadata are complete. The class is awaiting a final review by someone other than the term editor."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
