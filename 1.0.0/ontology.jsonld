    "@language" : "de",
    "@value" : "Ein Themenfeld ist eine textuelle Entität, die einen fachlichen, inhaltlichen oder konzeptuellen Bereich bezeichnet, dem eine Entität thematisch zugeordnet ist."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Themenfeld"
  }, {
    "@language" : "en",
    "@value" : "subject area"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000300"
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "Themenfeld wird Berlin/Brandenburg im Datendump im Zusammenhang mit Übung verwendet"
  } ]
