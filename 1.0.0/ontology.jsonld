  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Schulfachbezug, der ausdrückt, dass ein Schulfach als dritte Fremdsprache gemeint ist."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
