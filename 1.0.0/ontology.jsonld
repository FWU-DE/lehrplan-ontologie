    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000349"
  }, {
    "@id" : "_:genid1025"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0002140",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Kompetenz (MV)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid1029"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "Fachspezifische Kompetenz (MV)"
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "\"Fachspezifische Kompetenz\" in Mathe Primar"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0002143",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Themenbereich (MV)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000349"
  }, {
    "@id" : "_:genid1033"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "Arbeitsbereich (MV)"
  }, {
    "@value" : "Gegenstandsfeld (MV)"
  }, {
    "@value" : "Lebens- und Lernbereich (MV)"
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "\"Arbeitsbereich\" in Deustch\n\"Gegenstandsfeld\" in Kunst\n\"Lebens- und Lernbereich\" in Fremdsprache Primar"
  }, {
    "@value" : "Aus dem Lehrplan Deutsch Gesamtschule (2024) zu “Arbeitsbereich”: “Im Rahmenplan werden Arbeitsbereiche ausgewiesen, denen inhaltlich verbundene Themen zugeordnet werden. Die Fortführung der Arbeitsbereiche in den aufsteigenden Klassen ermöglicht Anknüpfungspunkte für die Lernenden im Sinne einer kompetenz- und sachwissensorientierten Lernprogression.”"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0002144",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Verbindlicher Inhalt (MV)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid1037"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "Inhalt (MV)"
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "Aus dem Lehrplan Deutsch Gesamtschule (2024) zu “verbindliche Inhalte”: “Die Konkretisierung der Themen erfolgt in Form der Ausweisung verbindlicher Inhalte in Abschnitt 2.3.”"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0002145",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Hinweis und Anregung (MV)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid1041"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "Hinweis (MV)"
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "Aus dem Lehrplan Deutsch Gesamtschule (2024) “Hinweise und Anregungen”: “Neben Anregungen für die Umsetzung im Unterricht werden sowohl didaktische und methodische Hinweise zur Auseinandersetzung mit den verbindlichen Inhalten gegeben als auch exemplarisch Möglichkeiten für die fachübergreifende und fächerverbindende Arbeit sowie fachinterne Verknüpfungen aufgezeigt.”"
  }, {
    "@value" : "Sie sind einem verbindlichen Inhalt zugeordnet und einem Arbeitsbereich untergeordnet."
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0002147",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Thema (MV)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000349"
  }, {
    "@id" : "_:genid1045"
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "Aus dem Lehrplan Deutsch Gesamtschule (2024) zu “Themen”: “Für den Unterricht werden in Abschnitt 2.3 verbindliche und/oder wahlobligatorische Themen benannt und im Tabellenkopf hervorgehoben. Die Reihenfolge der Themen hat keinen normativen, sondern empfehlenden Charakter.”"
  }, {
    "@value" : "Kommen u.a. im Fach Mathematik, Biologie und Englisch vor."
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0002149",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Verweis auf Möglichkeiten der Verknüpfung (MV)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0030065"
  }, {
    "@id" : "_:genid1049"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "Verweis auf Verknüpfung (MV)"
  }, {
    "@value" : "Verweis auf methodische Hinweise und Verknüpfungshinweise (MV)"
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "verweist auf andere Arbeitsbereiche und Querschnittsthemen"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0002151",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Fach Deutsch in der Sek I"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Konkretisierung (MV)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid1062"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0002153",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Standard (MV)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid1066"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "de",
    "@value" : "KMK-Bildungsstandard (MV)"
  }, {
    "@value" : "Abschlussbezogener Standard (MV)"
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "\"KMK-Bildungsstandard\" bisher nur in Fach Deutsch, Schulstufe Sek II gefunden. Ist gleichzusetzen mit Kompetenzen."
  }, {
    "@value" : "Aus dem Lehrplan Deutsch Gesamtschule (2024) zu \"Kompetenzen\": “Im Zentrum des Fachunterrichts steht der Kompetenzerwerb. Die Kompetenzen werden in der Auseinandersetzung mit den verbindlichen Themen entwickelt. In Abschnitt 2.2 werden die zu erreichenden Kompetenzen benannt. “"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0002158",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
