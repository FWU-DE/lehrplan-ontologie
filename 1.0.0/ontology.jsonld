  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/BFO_0000051"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@value" : "Ein Bildungsgang (occurent) endet mit Abschluss."
  } ]
