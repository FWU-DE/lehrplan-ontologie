  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "kommt vor im Fach Mathematik im Gymnasium Sek I und Naturwissenschaften/ Physik Gemeinschaftsschule"
  } ]
}, {
