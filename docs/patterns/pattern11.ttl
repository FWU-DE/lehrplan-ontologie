@prefix hat_Niveau: <https://w3id.org/lehrplan/ontology/LP_0000840> .
@prefix hat_Jahrgangsstufe: <https://w3id.org/lehrplan/ontology/LP_0000026> .

ex:Standard_BE a Standard_BE: ;
               hat_Niveaustufe: Niveaustufe_E: .
