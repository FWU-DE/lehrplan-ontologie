               hat_Niveau: MSA_E: .
MSA_E: a MSA_Niveau: ;
       hat_Jahrgangsstufe: Jahrgangsstufe_6: ,
                           Jahrgangsstufe_7: ,
                           Jahrgangsstufe_8: .
MSA_Niveau: rdfs:subClassOf Realschulniveau: .
Realschulniveau: rdfs:subClassOf Bildungsgangniveau: .
