    <owl:Class rdf:about="https://w3id.org/lehrplan/ontology/LP_0030335">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lehrplan/ontology/LP_0030325"/>
        <rdfs:subClassOf>
            <owl:Class>
