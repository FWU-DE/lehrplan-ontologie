    <!-- https://w3id.org/lehrplan/ontology/LP_0010001 -->

    <owl:Class rdf:about="https://w3id.org/lehrplan/ontology/LP_0010001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lehrplan/ontology/LP_0000037"/>
        <rdfs:label xml:lang="de">Fremdsprachenniveau</rdfs:label>
        <skos:definition xml:lang="de">Das “Fremdsprachenniveau” ist ein “Niveau”. Es entspricht dem Gemeinsamen Europäischen Referenzrahmen für Sprachen (GER), der die Sprachbeherrschung einer Fremdsprache in sechs Stufen von A1 (Anfänger) bis C2 (annähernd muttersprachliches Niveau) systematisiert. Das Fremdsprachenniveau gibt an, in welchem Umfang Lernende die Sprache verstehen, sprechen, lesen und schreiben können, und dient als Vergleichsgrundlage innerhalb von Bildungsabschlüssen und internationalen Qualifikationen.</skos:definition>
        <skos:definition xml:lang="en">The &quot;Fremdsprachenniveau&quot; is a &quot;Niveau&quot;.
It corresponds to the Common European Framework of Reference for Languages (CEFR), which systematizes foreign language proficiency into six levels from A1 (beginner) to C2 (near-native proficiency).
The &quot;Fremdsprachenniveau&quot; indicates the extent to which learners can understand, speak, read, and write the language, and serves as a basis for comparison within educational qualifications and international certifications.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lehrplan/ontology/LP_0030003 -->

    <owl:Class rdf:about="https://w3id.org/lehrplan/ontology/LP_0030003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000300"/>
        <rdfs:label xml:lang="de">Beschreibung</rdfs:label>
        <rdfs:label xml:lang="en">description</rdfs:label>
        <skos:definition xml:lang="de">Eine Beschreibung ist eine textuelle Entität, die Eigenschaften, Merkmale, Inhalte oder Zusammenhänge einer Entität in erklärender oder erläuternder Form darstellt. Sie ergänzt den Titel oder Namen und dient dazu, den Inhalt, Zweck, Status oder Kontext eines Objekts verständlicher zu machen. Sie kann mehrere Sätze oder Absätze enthalten.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lehrplan/ontology/LP_0030065 -->

    <owl:Class rdf:about="https://w3id.org/lehrplan/ontology/LP_0030065">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/lehrplan/ontology/LP_0000261"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/lehrplan/ontology/LP_0000483"/>
                        <owl:hasValue rdf:resource="https://w3id.org/lehrplan/ontology/LP_0002158"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/lehrplan/ontology/LP_0000261"/>
        <rdfs:label xml:lang="de">CE-Verweis</rdfs:label>
        <rdfs:label xml:lang="en">reference</rdfs:label>
        <skos:definition xml:lang="en">A &quot;CE-Verweis&quot; is a &quot;Curriculares Element&quot; that establishes a connection from one “Curriculares Element” to another element within the same curriculum, a different curriculum, or external resources. The &quot;CE-Verweis&quot; is not the linked object itself but rather a reference to it.</skos:definition>
        <skos:definition xml:lang="de">Ein “CE-Verweis” ist ein “Curriculares Element”, das einen Bezug von einem Curricularen Element zu einem anderen Element desselben Lehrplans, eines anderen Lehrplans oder externen Ressourcen herstellt. Dabei ist der “CE-Verweis” nicht selbst das verlinkte Objekt, sondern stellt eine Referenz darauf dar.</skos:definition>
    </owl:Class>
    


