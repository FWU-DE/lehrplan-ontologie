                    <rdf:Description rdf:about="https://w3id.org/lehrplan/ontology/LP_0000536"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/lehrplan/ontology/LP_0000483"/>
                        <owl:hasValue rdf:resource="https://w3id.org/lehrplan/ontology/LP_0030326"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="de">Weiteres Thema (Bistas)</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lehrplan/ontology/LP_0030361 -->

    <owl:Class rdf:about="https://w3id.org/lehrplan/ontology/LP_0030361">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lehrplan/ontology/LP_0000028"/>
        <rdfs:label xml:lang="de">Grundschulniveau</rdfs:label>
        <skos:definition>Das “Grundschulniveau” ist ein “Bildungsgangniveau”, welches das Niveau einer Schülerin oder eines  Schülers im Primarbereich beschreibt. 
Es beschreibt in welcher Tiefe und mit welchem Anspruch die Lerninhalte und Kompetenzen im Primarbereich behandelt werden.</skos:definition>
    </owl:Class>
    


